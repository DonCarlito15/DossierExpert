<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #2c3e50; -fx-padding: 10 15 10 15;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.DRJ.dossierexpert.controller.TopBarController">

    <Text fx:id="pageTitle" style="-fx-fill: white; -fx-font-weight: bold; -fx-font-size: 18px;" text="📋 لوحة التحكم">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Text>

    <Text style="-fx-fill: #7f8c8d; -fx-font-size: 16px;" text="|" />

    <Text fx:id="dateLabel" style="-fx-fill: #ecf0f1; -fx-font-size: 13px;" text="📅 24/07/2026">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Text>

    <Region HBox.hgrow="ALWAYS" />

    <Text fx:id="userLabel" style="-fx-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" text="👤 Utilisateur">
        <font>
            <Font name="System Bold" size="16.0" />
        </font>
    </Text>

    <Button onAction="#handleLogout" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 15 6 15; -fx-cursor: hand;" text="⏻">
        <font>
            <Font size="14.0" />
        </font>
    </Button>

</HBox>